    "note_priority_ne_order": "Priority는 실행 순서가 아니다 (PROJECT_SPEC.md §6.4). S_score 최고 Topic이 P1/P2에 없으면 원인가설 대상에 별도 추가할 것.",
    "weights": {
      "F": 0.4,
      "S": 0.4,
      "T": 0.2
    },
    "F_cap_pct": 20,
    "f_score_formula": "F_score = min(Frequency_pct / 20, 1) × 100",
    "trend_score_anchors": [
      {"trend_raw_pct": -100, "t_score": 0},
      {"trend_raw_pct": 0,    "t_score": 50},
      {"trend_raw_pct": 100,  "t_score": 100}
    ],
    "trend_min_sample_per_period": 5,
    "trend_insufficient_score": 50,
    "grade_rule": {
